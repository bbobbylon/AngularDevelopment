{
  "name": "angulartutorials",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"*.{json,md}\" \"docs/**/*.md\" \"aws/**/*.md\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"*.{json,md}\" \"docs/**/*.md\" \"aws/**/*.md\" \".github/**/*.yml\"",
    "verify": "npm run format:check && npm run typecheck && npm run test:ci && npm run build"
  },
  "private": true,
  "packageManager": "npm@11.5.2",
  "engines": {
    "node": "^22.0.0",
    "npm": "^11.0.0"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.0",
    "axe-core": "^4.13.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
